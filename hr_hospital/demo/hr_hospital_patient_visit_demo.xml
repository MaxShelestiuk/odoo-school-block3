        <field name="name">Плановий огляд Пилипа Орлика</field>
        <field name="patient_id" ref="hr_hospital_patient_demo_1"/>
        <field name="doctor_id" ref="hr_hospital_doctor_demo_1"/>
        <field name="visit_datetime">2026-11-10 08:00:00</field>
        <field name="state">planned</field>
    </record>

    <record id="patient_visit_demo_2" model="hr.hospital.patient.visit">
        <field name="name">Консультація Івана Виговського</field>
        <field name="patient_id" ref="hr_hospital_patient_demo_2"/>
        <field name="doctor_id" ref="hr_hospital_doctor_demo_3"/>
        <field name="visit_datetime">2026-11-11 09:00:00</field>
        <field name="state">planned</field>
    </record>

    <record id="patient_visit_demo_3" model="hr.hospital.patient.visit">
        <field name="name">Завершений огляд Пилипа Орлика</field>
        <field name="patient_id" ref="hr_hospital_patient_demo_1"/>
        <field name="doctor_id" ref="hr_hospital_doctor_demo_1"/>
        <field name="visit_datetime">2026-09-10 08:00:00</field>
