<odoo>
    <record id="hr_hospital_patient_visit_view_list" model="ir.ui.view">
        <field name="name">hr.hospital.patient.visit.view.list</field>
        <field name="model">hr.hospital.patient.visit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="visit_datetime"/>
                <field name="actual_visit_datetime" optional="hide"/>
                <field name="disease_id" optional="hide"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="hr_hospital_patient_visit_view_form" model="ir.ui.view">
        <field name="name">hr.hospital.patient.visit.view.form</field>
        <field name="model">hr.hospital.patient.visit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="active" invisible="1"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                            <field name="disease_id"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="visit_datetime"/>
                            <field name="actual_visit_datetime"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Епікриз">
                            <field name="summary"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_hospital_patient_visit_action" model="ir.actions.act_window">
        <field name="name">Patient Visits</field>
        <field name="res_model">hr.hospital.patient.visit</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
