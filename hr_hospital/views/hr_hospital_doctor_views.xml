<odoo>
    <record id="hr_hospital_doctor_view_list" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.view.list</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category_id"/>
                <field name="supervisor_doctor_id"/>
            </list>
        </field>
    </record>

    <record id="hr_hospital_doctor_view_form" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.view.form</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category_id"/>
                        <field name="supervisor_doctor_id"/>
                    </group>
                    <group string="Медичні дані">
                        <field name="blood_group"/>
                        <field name="gender"/>
                        <field name="birth_date"/>
                        <field name="age"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_hospital_doctor_action" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">hr.hospital.doctor</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>